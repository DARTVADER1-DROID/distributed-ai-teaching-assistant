{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "main.ts",
    "config/**/*.ts",
    "validator/**/*.ts",
    "extractor/**/*.ts",
    "chunker/**/*.ts",
    "embedding/**/*.ts",
    "vdb-manager/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}