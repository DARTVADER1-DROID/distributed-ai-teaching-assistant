{
  "name": "electron-rag-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Electron-based RAG server",
  "scripts": {
    "dev": "tsx watch main.ts",
    "build": "tsc -p tsconfig.json && npm test",
    "test:schema": "tsx vdb-manager/course-table-schema.test.ts",
    "test:duplicates": "tsx vdb-manager/course-duplicate-checker.test.ts",
    "test:pipeline": "tsx vdb-manager/create-course.test.ts",
    "test:repository": "tsx vdb-manager/course-repository.test.ts",
    "start": "node dist/main.js",
    "test:api": "tsx api-routes.test.ts",
    "test:pdf": "tsx pdf/pdfjs-document-parser.test.ts",
    "test": "npm run test:config && npm run test:schema && npm run test:duplicates && npm run test:pipeline && npm run test:pdf && npm run test:repository && npm run test:api",
    "test:config": "tsx config/config.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@lancedb/lancedb": "0.41.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "6.5.438",
    "swagger-ui-express": "^5.0.1",
    "apache-arrow": "21.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
