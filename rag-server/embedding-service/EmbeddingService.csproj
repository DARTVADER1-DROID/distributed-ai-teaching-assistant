<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1"
                      Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-arm64" Version="1.4.1"
                      Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-x64" Version="1.4.1"
                      Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-arm64" Version="1.4.1"
                      Condition="'$(RuntimeIdentifier)' == 'linux-arm64'" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-x64" Version="1.4.1"
                      Condition="'$(RuntimeIdentifier)' == 'osx-x64'" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.1"
                      Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" />
  </ItemGroup>
</Project>
